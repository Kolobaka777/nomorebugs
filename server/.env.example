# Copy this file to `.env` and fill in real values before starting the server.

# Required. Secret used to sign/verify JWT auth tokens.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Optional. Port the API server listens on.
PORT=5001

# Optional. Comma-separated list of frontend origins allowed to call this API
# (CORS). Defaults to the local Vite dev server if unset.
CORS_ORIGIN=http://localhost:5173

# Optional. Enables Telegram login/registration + notifications (security
# alerts, role changes, etc). Get one from @BotFather on Telegram
# ("/newbot"). Leave unset to disable the feature entirely — the
# "Войти через Telegram" button hides itself and everything else degrades
# to the SMTP fallback below (or a silent no-op if that's unset too).
TELEGRAM_BOT_TOKEN=

# Optional. SMTP fallback for notifications, used only when a user has no
# Telegram linked. All four must be set together or none of them apply.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Optional. Defaults to SMTP_USER if unset.
SMTP_FROM=

# Optional. Enables server-side error tracking. Get a DSN from sentry.io
# (or a self-hosted instance). Leave unset to disable entirely — errors
# still print to the console as before, just aren't shipped anywhere.
SENTRY_DSN=

# Optional. Where automated DB backups are written (see
# server/src/backup.js). Defaults to a `backups/` folder next to the live
# DB file — only override this if that default isn't writable/desirable.
BACKUP_DIR=

# Optional. Ships every local backup to an S3-compatible bucket too — the
# fix for "the whole volume (live DB + all local backups) is lost/corrupted
# at once" (disk failure, an accidental volume delete), which on-volume
# backups alone can't protect against. Leave all of these unset to disable
# — nothing changes, backups stay local-only as before.
#
# Recommended providers (both have a free tier well above what a DB this
# size needs, and are fully S3-API-compatible so no code changes needed):
#   - Cloudflare R2 — BACKUP_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com,
#     BACKUP_S3_REGION=auto, no egress fees. Simplest choice if you're not
#     already using AWS.
#   - Backblaze B2 (S3-compatible API) — BACKUP_S3_ENDPOINT=https://s3.<region>.backblazeb2.com,
#     BACKUP_S3_REGION=<region, e.g. us-west-004>. Similarly cheap.
#   - Real AWS S3 also works — leave BACKUP_S3_ENDPOINT unset, set
#     BACKUP_S3_REGION to a real AWS region (e.g. eu-central-1).
# For any provider: set a bucket lifecycle rule to auto-expire objects
# older than ~30 days instead of managing remote pruning here.
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=auto
# Optional. Defaults to "backups/" — the folder/prefix inside the bucket.
BACKUP_S3_PREFIX=
