# Copy this file to `.env` and adjust for your environment.
# Not required for local dev — defaults to http://localhost:5001/api.

VITE_API_BASE_URL=http://localhost:5001/api

# Optional. Enables client-side error tracking. Get a DSN from sentry.io
# (or a self-hosted instance). Leave unset to disable entirely — everything
# just goes to the browser console as before, same as local dev.
VITE_SENTRY_DSN=

# Optional. Enables product analytics (pageviews + autocapture). Get a key
# from posthog.com (or a self-hosted instance). Leave unset to disable.
VITE_POSTHOG_KEY=
# Optional. Defaults to PostHog's US cloud if unset.
VITE_POSTHOG_HOST=https://us.i.posthog.com

# Optional, runtime (not build-time) — the client container substitutes it
# into the CSP's connect-src at start. Must be the API's *origin* only, no
# path, and must agree with VITE_API_BASE_URL above; otherwise the browser
# blocks every request the bundle makes. Leave unset when a reverse proxy
# serves the API under this same domain — connect-src then stays at 'self'.
#   API_ORIGIN=https://api.example.com
API_ORIGIN=
