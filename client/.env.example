# Copy this file to `.env` and adjust for your environment.
# Not required for local dev — defaults to http://localhost:5001/api.

VITE_API_BASE_URL=http://localhost:5001/api

# Optional. Enables client-side error tracking. Get a DSN from sentry.io
# (or a self-hosted instance). Leave unset to disable entirely — everything
# just goes to the browser console as before, same as local dev.
VITE_SENTRY_DSN=

# Optional. Enables product analytics (pageviews + autocapture). Get a key
# from posthog.com (or a self-hosted instance). Leave unset to disable.
VITE_POSTHOG_KEY=
# Optional. Defaults to PostHog's US cloud if unset.
VITE_POSTHOG_HOST=https://us.i.posthog.com
