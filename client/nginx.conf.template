# Cache policy as a variable rather than as a second location block. This
# is not a style choice: nginx's add_header does not accumulate across
# levels — a location that declares even one add_header of its own inherits
# none of the ones above it. The old config set Cache-Control inside
# `location /assets/`, which silently dropped X-Content-Type-Options,
# X-Frame-Options, Referrer-Policy and the CSP for every JavaScript and CSS
# file the app serves. Deciding the value here keeps all headers at exactly
# one level, where there is nothing for nginx to undo.
#
# index.html itself must not be cached, or a deploy ships new fingerprinted
# assets that nobody's browser is told to go and fetch.
map $uri $asset_cache_control {
    default       "no-cache";
    ~^/assets/    "public, max-age=31536000, immutable";
}

server {
    listen ${PORT};
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # `always` so these are set on error responses too — a 404 rendered
    # from index.html is still a page that can be framed or sniffed.
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Cross-Origin-Opener-Policy "same-origin" always;
    add_header Cache-Control $asset_cache_control always;

    # connect-src used to be `*`, left open because the API origin is a
    # build-time value (VITE_API_BASE_URL) this config cannot see — which
    # made the rest of the policy largely decorative. It is substituted at
    # container start from API_ORIGIN instead. Unset, it collapses to
    # 'self', correct for the common setup where a reverse proxy serves
    # /api under this same domain, and wrong in a way that shows up
    # immediately in the console rather than silently.
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self' ${API_ORIGIN}; base-uri 'self'; form-action 'self'; object-src 'none'; frame-ancestors 'none'" always;

    # React Router uses client-side routing — any path that isn't a real
    # file (e.g. /zhukademia) must still serve index.html, or a hard
    # refresh/direct link on any non-root route would 404.
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Text compresses to roughly a quarter of its size and the app ships
    # several hundred KB of it. gzip rather than brotli: brotli needs a
    # module the official nginx image does not carry, and the gap between
    # them is far smaller than the gap between gzip and nothing.
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_proxied any;
    gzip_types text/plain text/css text/javascript application/javascript
               application/json image/svg+xml application/manifest+json;
}
